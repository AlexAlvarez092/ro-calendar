# Copy this file to .env. You can set either one shared key,
# or two explicit keys (backend + webview).
# If none are set, the app tries dynamic discovery from laliga.com runtime config.

# Legacy/shared key (optional)
LALIGA_API_KEY=

# Preferred explicit keys (optional)
LALIGA_BACKEND_API_KEY=
LALIGA_WEBVIEW_API_KEY=
